# ---------------------------------------------------------------------------
# Doxygen configuration for MinFlyout (tested with Doxygen 1.9.x)
#
#   doxygen                      run in the project directory
#   build/docs/html/index.html   result
#
# Only deliberately set options are listed; everything else stays at the
# Doxygen default. "doxygen -u Doxyfile" fills in the full version if needed.
# ---------------------------------------------------------------------------

# --- Project ---------------------------------------------------------------
PROJECT_NAME           = "MinFlyout"
PROJECT_NUMBER         = 1.0
PROJECT_BRIEF          = "Flyout above the minimize button (Win32/C++17)"
OUTPUT_DIRECTORY       = build
OUTPUT_LANGUAGE        = English
CREATE_SUBDIRS         = NO
TAB_SIZE               = 4

# --- Input -----------------------------------------------------------------
INPUT                  = docs \
                         src \
                         res \
                         tests
FILE_PATTERNS          = *.h *.cpp *.dox
RECURSIVE              = YES
EXCLUDE                = build build-mingw out .vs
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = src
INPUT_ENCODING         = UTF-8

# --- Scope -----------------------------------------------------------------
# EXTRACT_ALL stays off so that undocumented elements show up as warnings.
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
# Internal helpers in anonymous namespaces are left out.
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
INTERNAL_DOCS          = NO
SHOW_USED_FILES        = YES
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO

# --- Comment style ---------------------------------------------------------
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO
INHERIT_DOCS           = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
TYPEDEF_HIDES_STRUCT   = YES
BUILTIN_STL_SUPPORT    = YES

# --- Preprocessor ----------------------------------------------------------
# Without these substitutions the parser trips over the Win32 calling conventions.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = src
PREDEFINED             = _WIN32 \
                         _MSC_VER=1930 \
                         UNICODE \
                         _UNICODE \
                         WINAPI= \
                         CALLBACK= \
                         WINUSERAPI= \
                         __declspec(x)=

# --- Warnings --------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
WARN_LOGFILE           = build/doxygen-warnings.log

# --- Output ----------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = doxygen-html
HTML_COLORSTYLE        = TOGGLE
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
SEARCHENGINE           = YES
ALPHABETICAL_INDEX     = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
VERBATIM_HEADERS       = YES

GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

# --- Diagrams --------------------------------------------------------------
# Set HAVE_DOT to YES when Graphviz is installed - call and dependency graphs
# are then produced as well.
HAVE_DOT               = NO
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
