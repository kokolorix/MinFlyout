// MinFlyout - configuration
//
// This file is JSONC: comments (// and /* */) and trailing commas are
// allowed. Saving the file applies the changes right away; the tray menu
// command "Reload configuration" does the same by hand.
{
  // How long the pointer must rest on the minimize button before the flyout opens.
  "hoverDelayMs": 350,

  // Grace period before the flyout closes again after the pointer leaves.
  "closeGraceMs": 260,

  // Show the built-in items (minimize, notification area, ...) below the layouts.
  "showBuiltinItems": true,

  // true  = percentages refer to the work area (without the taskbar)
  // false = percentages refer to the full monitor area
  "useWorkArea": true,

  // true  = show every monitor, so a window can be moved across screens
  // false = only show the monitor the window is currently on
  "showAllMonitors": true,

  "uiScale": 1.4, // size factor of the flyout, on top of the DPI scaling

  // How the minimize button is located.
  //   "auto"      ask the window, and compute the position when it stays
  //               silent - which is what apps with their own title bar do
  //   "hittest"   only ask; a window that does not answer is not detected
  //   "computed"  never ask, always compute
  "buttonDetection": "auto",

  // Log every gate of the detection, not just the successful ones. Answers
  // "where does the mouse movement die?" - one line per change.
  "traceDetection": false,

  // Write the debug log to minflyout.log next to this file. The log always
  // goes to the debugger output; this adds the file (rotated at 1 MB).
  // Only has an effect in builds with logging compiled in.
  "logToFile": false,

  // Watch this file and reload it as soon as it is saved. Turn it off if
  // %APPDATA% lives on a network share that reports no changes.
  "watchConfig": true,

  // Layouts. Each layout is drawn as a miniature of the monitor, each of its
  // zones as a tile inside it. Clicking a tile moves the window to that zone
  // on that monitor.
  //
  //   name      Caption below the miniature
  //   zones     left / top / width / height, each in percent of the monitor
  //   monitors  Which screens the layout is offered on. Omit it for all of
  //             them. Allowed entries, mixable in one list:
  //               1, 2, ...      the monitor number the flyout caption shows
  //               "primary"      the primary screen
  //               "secondary"    every screen that is not the primary one
  //               "DISPLAY2"     the device name from the caption
  //               "3840x2160"    every screen with that resolution
  //             A screen without a single matching layout is left out of
  //             the flyout.
  //
  // Zones are meant to tile the screen without overlapping, the way the
  // Windows snap layouts do. Add or remove layouts as you like.
  "layouts": [
    {
      "name": "Halves",
      "monitors": [ 1 ],
      "zones": [
        { "left": 1, "top": 1, "width": 46, "height": 96 },
        { "left": 52, "top": 1, "width": 46, "height": 96 },
        // { "left": 8, "top": 8, "width": 84, "height": 84 },
        { "left": 10, "top": 10, "width": 80, "height": 80 },
        { "left": 20, "top": 20, "width": 60, "height": 60 },
        { "left": 5, "top": 6, "width": 94, "height": 94 }
      ]
    },
    {
      "name": "Quarters",
      "monitors": [ 1 ],
      "zones": [
        { "left": 1, "top": 1, "width": 47, "height": 47 },
        { "left": 52, "top": 1, "width": 47, "height": 47 },
        { "left": 1, "top": 51, "width": 47, "height": 47 },
        { "left": 52, "top": 51, "width": 47, "height": 47 },
        { "left": 2, "top": 2, "width": 96, "height": 96 }
        // { "left": 1, "top": 1, "width": 98, "height": 98 }
      ]
    }
    // {
    //   "name": "Full screen",
    //   "zones": [
    //     { "left": 0, "top": 0, "width": 100, "height": 100 },
    //   ],
    // },
  ],

  // Dragging a window into a zone with the finger.
  //
  // Pick up a window by its title bar and move it. A field appears where
  // "trigger" puts it; rest the finger in it for "dwellMs" and the zones
  // below unfold across the screen. Let go over one of them and the window
  // lands there; let go anywhere else and nothing happens.
  //
  // Touch gets its own layouts because the task is a different one: with a
  // window already in mid-drag there is exactly one arrangement on offer,
  // not a menu of five. The first layout matching the monitor is the one
  // that shows - which is also how a tablet gets one arrangement upright
  // and another on its side, through "monitors". Leave "layouts" out
  // entirely and the ones above are used instead.
  "touch": {
    "enabled": true,

    // React to a window dragged with the mouse as well. Off by default -
    // with a mouse the flyout is the shorter way. Turn it on to try the
    // overlay out on a machine without a touchscreen.
    "alsoMouse": false,

    // How long the finger has to rest in the field before the zones unfold.
    // Too short and merely carrying a window across the middle of the screen
    // opens them.
    "dwellMs": 250,

    // The field, in percent of the same reference area the zones use. The
    // default is a fifth of the screen in its middle; it is only on screen
    // while a window is actually being dragged, so it may be generous.
    "trigger": {
      "left": 40,
      "top": 40,
      "width": 20,
      "height": 20
    },

    "layouts": [
      {
        "name": "Touch",
        "zones": [
          { "left": 2, "top": 2, "width": 46, "height": 96 },
          { "left": 51, "top": 2, "width": 46, "height": 96 },
          { "left": 3, "top": 3, "width": 45.5, "height": 45.5 },
          { "left": 3, "top": 51.5, "width": 45.5, "height": 45.5 },
          { "left": 51.5, "top": 3, "width": 45.5, "height": 45.5 },
          { "left": 51.5, "top": 51.5, "width": 45.5, "height": 45.5 },
          // { "left": 50, "top": 50, "width": 50, "height":  50 },
          { "left": 7, "top": 7, "width": 86, "height": 86 }
        ]
      }
    ]
  }
}
