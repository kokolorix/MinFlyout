// ---------------------------------------------------------------------------
// MinFlyout - resources
// Deliberately ASCII only, so that MSVC (rc.exe) and MinGW (windres) both
// process the file without a codepage specification.
// ---------------------------------------------------------------------------
#include <windows.h>
#include "resource.h"

// Written by tools/GenerateVersion.ps1 before every build (Visual Studio:
// pre-build event, CMake: the "version" target). Not under version control.
#include "Version.h"

// Explorer uses the numerically lowest icon resource as the file icon -
// that is why the application icon stands alone and comes first.
IDI_APPICON ICON "minflyout.ico"

// Visual Studio binds the manifest in via the manifest tool (see
// minflyout.vcxproj). MinGW has no such tool - there it is embedded here;
// CMake defines MFLY_EMBED_MANIFEST accordingly.
#ifdef MFLY_EMBED_MANIFEST
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "minflyout.manifest"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_FILEVERSION
 PRODUCTVERSION VER_PRODUCTVERSION
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG | VER_FILEFLAGS_DIRTY
#else
 FILEFLAGS      VER_FILEFLAGS_DIRTY
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"          // US English, Unicode
        BEGIN
            // Composed by the generator: windres does not join adjacent
            // string literals the way rc.exe does.
            VALUE "FileDescription", VER_FILEDESCRIPTION_STR
            VALUE "FileVersion",     VER_FILEVERSION_STR
            VALUE "InternalName",    "minflyout"
            VALUE "LegalCopyright",  "Copyright (c) 2026"
            VALUE "OriginalFilename","minflyout.exe"
#if VER_DIRTY
            VALUE "PrivateBuild",    "Built from a working tree with uncommitted changes"
#endif
            VALUE "ProductName",     "MinFlyout"
            VALUE "ProductVersion",  VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// About dialog, see src/AboutDialog.cpp. The list view gets its report
// styles in code, so this file needs no commctrl.h.
IDD_ABOUT DIALOGEX 0, 0, 300, 316
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "About MinFlyout"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDI_APPICON,IDC_STATIC,14,14,21,20
    LTEXT           "MinFlyout",IDC_ABOUT_VERSION,42,14,244,8,SS_NOPREFIX
    LTEXT           "Copyright (c) 2026",IDC_STATIC,42,26,244,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,14,42,272,1
    LTEXT           "commit",IDC_STATIC,14,52,26,8
    LTEXT           "",IDC_ABOUT_COMMIT,44,52,184,8,SS_NOPREFIX | SS_NOTIFY
    PUSHBUTTON      "&Copy",IDC_ABOUT_COPY,238,49,48,14
    LTEXT           "",IDC_ABOUT_BUILT,14,66,272,8,SS_NOPREFIX
    LTEXT           "",IDC_ABOUT_DIRTY,14,78,272,8,SS_NOPREFIX
    LTEXT           "Keyboard and mouse",IDC_STATIC,14,94,272,8
    CONTROL         "",IDC_ABOUT_SHORTCUTS,"SysListView32",WS_BORDER | WS_TABSTOP,14,105,272,184
    DEFPUSHBUTTON   "OK",IDOK,236,296,50,14,WS_GROUP
END
